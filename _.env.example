# Salin menjadi .env (jangan di-commit) lalu isi.

MYSQL_DATABASE=interval_db
MYSQL_ROOT_PASSWORD=ganti-dengan-password-root-yang-kuat
DB_USERNAME=interval
DB_PASSWORD=ganti-dengan-password-yang-kuat

# Minimal 32 karakter acak. Contoh membuatnya:  openssl rand -base64 48
JWT_SECRET=

# prod (bawaan): wajib FCM aktif dan berkas ./secrets/firebase-service-account.json.
# Untuk mencoba secara lokal tanpa Firebase, ganti ke dev (push hanya dicatat di log).
SPRING_PROFILES_ACTIVE=prod

# true untuk membuka Swagger UI (tidak disarankan di production)
SWAGGER_ENABLED=false
